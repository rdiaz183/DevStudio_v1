$Inbox = "C:\Users\rdiaz\Documents\Unreal Projects\Code510_AI_Workspace\01_Studio_Inbox"
$Workspace = "C:\Users\rdiaz\Documents\Unreal Projects\Code510_AI_Workspace"

Write-Host "Studio Inbox Watcher Active. Monitoring for incoming assets..." -ForegroundColor Cyan

while ($true) {
    $files = Get-ChildItem -Path $Inbox -File
    foreach ($file in $files) {
        $targetSubFolder = ""
        
        if ($file.Name -match 'ideation|concept|brainstorm|pitch|loop|tactics') {
            $targetSubFolder = "02_Ideation_Brainstorming\Tactics"
        }
        elseif ($file.Name -match 'lore|story|script|dialogue|quest|writer') {
            $targetSubFolder = "03_Narrative_And_Writing\Tactics"
        }
        elseif ($file.Name -match 'art|ui|ux|style|visual|prompt|image') {
            $targetSubFolder = "04_Art_And_Visuals\Art_Styles"
        }
        elseif ($file.Extension -match '\.(cpp|h|uasset|json|py|cs)$' -or $file.Name -match 'code|engine|system|state') {
            $targetSubFolder = "05_Engineering_And_Code\Tactics"
        }
        else {
            $targetSubFolder = "02_Ideation_Brainstorming\Future_Projects"
        }

        $destination = Join-Path $Workspace $targetSubFolder
        if (!(Test-Path $destination)) { New-Item -ItemType Directory -Path $destination -Force | Out-Null }
        
        Move-Item -Path $file.FullName -Destination $destination -Force
        Write-Host "[Auto-Sorted] Moved $($file.Name) -> $targetSubFolder" -ForegroundColor Green
    }
    Start-Sleep -Seconds 3
}
